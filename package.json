{
  "name": "rfe",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "seed": "pnpm --filter @rfe/v0 seed",
    "fresh": "pnpm --filter @rfe/v0 payload migrate:fresh",
    "docs:backoffice": "pnpm --filter @rfe/v0 docs:backoffice",
    "docs:backoffice:pdf": "pnpm --filter @rfe/v0 docs:backoffice:pdf",
    "dump:s3": "pnpm --filter @rfe/v0 dump:s3"
  },
  "devDependencies": {
    "next": "catalog:",
    "tsx": "^4.21.0",
    "turbo": "^2.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.11.0",
  "version": "0.0.1"
}
